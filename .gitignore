# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Private uploads (HIPAA / GDPR patient upload isolation)
uploads/*
!uploads/.gitkeep

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Database journal & local dumps
*.db-journal
*.sqlite3-journal
